# =============================================================================
# APRS-Agent .gitignore
# =============================================================================

# ── Config files (may contain API keys, passwords, personal callsign/location)
aprsconfig.toml
*.toml

# Keep the annotated template in the repo
!aprsconfig.toml.template

# ── Python cache
__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python

# ── Virtual environments
venv/
.venv/
env/
.env/

# ── PyInstaller build output
build/
dist/
*.spec
!aprs_agent.spec

# ── IDE / editor files
.vscode/
.idea/
*.swp
*.swo
*~

# ── OS files
.DS_Store
Thumbs.db
desktop.ini

# ── Logs
*.log
logs/

# ── Compiled extensions
*.so
*.dll

# ── Test artifacts
test_*.toml

# -- Station persistence database (local data, per-installation)
aprs_stations.db
