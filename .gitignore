# =============================================================================
# APRS-Agent .gitignore
# =============================================================================

# ── Config files (may contain API keys, passwords, personal callsign/location)
aprsconfig.toml
*.toml

# Keep the annotated template in the repo
!aprsconfig.toml.template

# ── Python cache
__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python

# ── Virtual environments
venv/
.venv/
env/
.env/

# ── PyInstaller build output
# Wildcards on purpose: a build into dist313/ (a second interpreter, kept
# beside the existing one) slipped past bare "dist/" and put 274 MB of
# binaries into a commit.
build*/
dist*/
*.spec
!aprs_agent.spec

# ── IDE / editor files
.vscode/
.idea/
*.swp
*.swo
*~

# ── OS files
.DS_Store
Thumbs.db
desktop.ini

# ── Logs
*.log
logs/

# ── Compiled extensions
*.so
*.dll

# ── Test artifacts
test_*.toml

# -- Station persistence database (local data, per-installation)
aprs_stations.db

# Release artefacts. Built by hand on the pinned 32-bit environment (see
# docs/RELEASE-HOWTO.md) and uploaded to GitHub Releases, not committed —
# v3.2.97's zip is 90 MB.
aprs-agent-v*.zip
