# =============================================================================
# APRS-Agent Configuration File
# =============================================================================
# Edit the values below with your own settings.
# Lines starting with '#' are comments and are ignored by the program.
#
# Developed by TA3HRJ & TA3PKS
# https://github.com/YOUR_USERNAME/aprs-agent
# =============================================================================

# --- APRS-IS Server Connection ---

# APRS-IS server address. Common choices:
#   rotate.aprs2.net  (worldwide rotation)
#   euro.aprs2.net    (Europe)
#   noam.aprs2.net    (North America)
server = "rotate.aprs2.net"

# APRS-IS port. Standard is 14580 (filtered) or 10152 (full feed).
port = 14580

# YOUR amateur radio callsign (required - must have a valid amateur license).
callsign = "N0CALL"

# Filter: which callsigns/wildcards to receive from the APRS-IS server.
# Use '*' as a wildcard. Examples:
#   "N0CALL*"   = your callsign and all SSIDs
#   "ta*"       = all Turkish amateur callsigns starting with TA
#   "N0CALL-*"  = all SSIDs of N0CALL
allowed_callsigns = ["N0CALL*"]

# Print the full parsed configuration to the console on startup (true/false).
print_config_on_startup = false

# Start receiving from APRS-IS automatically when the program launches,
# instead of waiting for you to click Start (true/false). Useful for running
# as a background service.
auto_start_agent = false

# Receive ALL worldwide APRS traffic (port 10152) instead of the filtered
# feed on the port above, ignoring allowed_callsigns entirely (true/false).
# ~50-100 packets/second — pair with rate_limit_pps below, or leave that at
# 0 only if you have also disabled per-packet processing you don't need.
full_feed = false

# Maximum packets per second dispatched to extensions (Logger, AI Gateway,
# silence detection, ...). Only matters with full_feed; the raw APRS-IS
# connection itself is never throttled. 0 = unlimited.
rate_limit_pps = 50

# Path to a Turkey Repeaters JSON database (see the Turkey Repeaters project).
# Enriches matching stations in the Stations tab with city, district,
# frequency, tone and band, and is required for the Repeater Monitor below.
# Leave empty to disable.
#   repeater_db_path = "C:/path/to/repeaters.json"
repeater_db_path = ""

# Read-only public monitoring page (Web GUI only). When set to a port number
# (e.g. 8082), a second web page is served on that port showing only the
# Live Log / Stations / Map views — no settings, no start/stop, no API keys.
# That port is safe to forward to the internet; NEVER expose the admin port.
# 0 = disabled.
public_port = 0

# Title and one-line description shown in the public page header, next to your
# callsign. Leave empty for the defaults: "APRS-Agent · CALLSIGN" and a
# language-aware product description.
#   public_title    = "APRS Monitoring Station"
#   public_subtitle = "Live view of the APRS network"
public_title = ""
public_subtitle = ""
# Optional "Home" link in the public header, e.g. "https://example.org/"
# Empty = no link shown.
public_home_url = ""


# =============================================================================
# Monitor (Repeater Monitor + Silence Map)
# =============================================================================
# Repeater Monitor notifies when a DB-matched repeater goes offline or comes
# back (requires repeater_db_path above). The Silence Map runs independently
# and always watches for regions where many stations fall silent together —
# these settings only shape its notifications and scope, not whether it runs.

[monitor]
enabled = false

# Comma-separated base callsigns to watch for the Repeater Monitor. Empty =
# watch every repeater in the DB.
watch_callsigns = []

notify_channel = "telegram"   # "telegram" or "smtp"
check_interval_mins = 10

# Maidenhead grid fields (first 2 characters) that silence detection is
# scoped to. A prefix station filter such as allowed_callsigns = ["TA*"]
# also matches callsigns abroad, and their outages would otherwise raise
# alerts too. Example: ["KM", "KN", "LM", "LN"] for Turkey. Empty = worldwide.
silence_grids = []

# Batch silence alerts into one combined notification every N minutes,
# instead of one message per alert — recommended once silence_grids is
# empty (worldwide), where individual alerts can flood the channel.
# 0 = send each alert immediately.
silence_digest_mins = 0

# Maidenhead fields a band-opening (RF propagation) NOTIFICATION is limited
# to — matches if EITHER end of any link in the opening falls in these
# fields, so a cross-continent opening reaching your region still notifies.
# The map and timeline always show every opening worldwide regardless of
# this setting; it only scopes the Telegram/email message.
# Example: ["KM", "KN", "LM", "LN"] for Turkey. Empty = notify on every opening.
prop_notify_grids = []


# =============================================================================
# Station AI (organisation extraction)
# =============================================================================
# Periodically sends heard stations' beacon comments to AI to extract an
# organisation name and description, shown in the Stations tab. Requires the
# AI Gateway extension below to be configured (same provider/API key reused).

[station_ai]
enabled = false
interval_hours = 24   # run every N hours
max_batch = 20        # max stations analysed per run


# =============================================================================
# Extension Server (TCP)
# =============================================================================
# Allows external programs on the same computer to connect and receive
# a live stream of APRS packets. Useful for integrations with other software.

[extension_server]
enabled = false
host = "127.0.0.1"   # Use 127.0.0.1 to allow only local connections
port = 65080


# =============================================================================
# Extensions
# =============================================================================

# --- Twitter / X Integration ---
# Posts incoming APRS messages to your Twitter/X account.
# Requires Twitter API credentials (see: https://developer.twitter.com)

[extensions.twitter]
enabled = false

# Twitter API credentials (get these from developer.twitter.com)
api_key = ""
api_secret = ""
access_token_key = ""
access_token_secret = ""

# Add #APRS hashtag to tweets automatically
add_hash_tag = true

# Only forward messages addressed TO these callsigns (APRS message recipients)
allowed_recepients = ["twsend", "TWSEND"]

# Only forward messages FROM these callsigns (APRS senders)
allowed_senders = ["N0CALL"]


# --- Logger ---
# Logs incoming APRS packets to the console (terminal window).

[extensions.logger]
enabled = true

# Also log APRS-IS server comment lines (lines starting with '#')
log_comments = true

# Only log packets whose APRS data type identifier is in this list.
# Remove characters to filter out those packet types.
# Common types: ! = position, : = message, ; = object, @ = pos+time
# Leave empty [] to log ALL packet types.
filter_by_message_type = ["!", "/", "\\", "@", "~", "`", "^", "&", "*", "(", ")", "_", "-", "=", "+", "[", "]", "{", "}", "|", ";", ":", "\"", "<", ">", "?", "."]

# Packet types to always exclude from logging (even if in filter list above).
exclude_by_message_type = []

# If set, ONLY log packets that contain these keywords (case-insensitive).
# Leave empty [] to use the type filter above instead.
keyword_filter = []


# --- Fixed Beacon ---
# Periodically sends your station's fixed position to the APRS network.

[extensions.fixed_beacon]
enabled = false

# Your station callsign + SSID for the beacon
# SSID examples: -5 = software, -9 = mobile, -10 = internet
ssid = "N0CALL-10"

# Latitude in APRS format: DDMM.MMN (degrees, minutes, N/S)
# Example: Istanbul area would be 4100.00N
lat = "0000.00N"

# Longitude in APRS format: DDDMM.MME (degrees, minutes, E/W)
# Example: Istanbul area would be 02900.00E
lon = "00000.00E"

# APRS symbol table ('/' = primary, '\' = alternate)
symbol_table = "/"

# APRS symbol character ('-' = house, '>' = car, 'k' = truck, etc.)
# See: http://www.aprs.org/symbols.html
symbol = "-"

# Text comment to include in the beacon packet
comment = "APRS-Agent | https://github.com/YOUR_USERNAME/aprs-agent"

# How often to send the beacon (in minutes)
beacon_interval_mins = 15


# --- SMTP Email ---
# Forwards APRS messages to email. Useful for receiving APRS messages
# when you are away from radio. Supports Gmail, Outlook, or any SMTP server.

[extensions.smtp]
enabled = false

# SMTP server address and port (format: "host:port")
# Gmail: "smtp.gmail.com:587"
# Outlook: "smtp.office365.com:587"
smtp_server = "smtp.example.com:587"

# Your email login username
smtp_username = "your@email.com"

# Your email login password (for Gmail use an App Password, not your main password)
smtp_password = ""

# Only forward APRS messages FROM these callsigns
allowed_senders = ["N0CALL"]

# Only forward APRS messages addressed TO these APRS callsigns/aliases
allowed_recipients = ["EMAIL"]

# Optional: restrict which destination email addresses are allowed.
# Leave empty [] to allow any email address.
allowed_receiver_emails = []

# The "From:" address shown in outgoing emails
from_email = "APRS-Agent <aprs@example.com>"

# --- Bluesky ---
# Posts incoming APRS messages to a Bluesky account (free API, no payment needed).
# Create an App Password at: bsky.app → Settings → App Passwords
# Send APRS messages to the "allowed_recepients" alias to trigger a post.

[extensions.bluesky]
enabled = false

# Your Bluesky handle (e.g. yourname.bsky.social)
username = ""

# App Password (NOT your main Bluesky password — create one specifically for this app)
app_password = ""

# Automatically append #APRS to every post
add_hash_tag = true

# Only post when the APRS message is addressed to one of these aliases
allowed_recepients = ["BSKYSEND"]

# Only accept messages FROM these callsigns
allowed_senders = ["N0CALL"]

# --- WhatsApp ---
# Bidirectional APRS ↔ WhatsApp via Meta Cloud API.
# Setup: create a Meta Business app at developers.facebook.com
# Get phone_number_id and access_token from the dashboard.
# Webhook URL: https://YOUR_SERVER/webhook/whatsapp

[extensions.whatsapp]
enabled = false

# From Meta Business dashboard
phone_number_id = ""
access_token = ""

# Custom string for webhook verification (must match Meta config)
verify_token = ""

# Default WhatsApp recipient phone number (with country code)
recipient_phone = ""

add_hash_tag = true
allowed_recepients = ["WASEND"]
allowed_senders = ["N0CALL"]

# Inbound (WhatsApp → APRS)
from_callsign = ""
aprs_destination = ""
allowed_phones = []

# --- Telegram ---
# Bidirectional APRS ↔ Telegram messaging (completely free).
# Setup: message @BotFather on Telegram to create a bot and get a token.
# Get your chat_id by messaging @userinfobot on Telegram.

[extensions.telegram]
enabled = false

# Bot token from @BotFather
bot_token = ""

# Telegram chat or group ID to send messages to
chat_id = ""

# Automatically append #APRS to outgoing messages
add_hash_tag = true

# Only forward APRS messages addressed TO these aliases
allowed_recepients = ["TGSEND"]

# Only forward APRS messages FROM these callsigns
allowed_senders = ["N0CALL"]

# Enable receiving Telegram messages and forwarding to APRS
poll_enabled = false

# How often to check for new Telegram messages (seconds)
poll_interval_secs = 5

# APRS callsign used as sender for forwarded Telegram messages
from_callsign = "TG-BOT"

# Default APRS destination if Telegram message doesn't specify a callsign
aprs_destination = ""

# --- AI Gateway ---
# Auto-responds to incoming APRS messages using an AI provider.
# Supports Puter (free), Groq, OpenRouter, or any OpenAI-compatible endpoint.
# Messages addressed to the configured callsign will get an AI-generated reply.

[extensions.ai_gateway]
enabled = false

# The callsign that triggers AI responses (messages addressed to this callsign)
callsign = "N0CALL"

# AI provider: "openai" (ChatGPT), "anthropic" (Claude), "deepseek", "groq",
# "openrouter", "puter" (free), or "custom"
provider = "puter"

# Custom base URL — only needed to override a provider's default endpoint
# (e.g. a proxy), or required if provider = "custom"
base_url = ""

# AI model name (leave empty for provider default)
model = ""

# Custom system prompt (leave empty for default APRS-optimized prompt)
system_prompt = ""

# If set, only messages starting with this prefix trigger AI (e.g. "AI")
trigger_prefix = ""

# Extra APRS addressees that trigger AI responses
trigger_aliases = []

# Who operates this gateway, announced on the network as an APRS status packet.
# The service addressee is not a callsign - it identifies software, not a
# station - so this is not a substitute for a licence. It is how somebody who
# meets your gateway can find you. Empty = nothing sent.
#   status_text = "AI gateway operated by N0CALL - example.org"
status_text = ""
status_interval_mins = 0

# Constrain what the model may produce. Your replies are transmitted by other
# licensees' igates, so the content has to stay inside amateur radio rules
# whatever the model feels like writing.
#   system_prompt = "You are an APRS assistant reached over amateur radio. #     Answer briefly and factually. Amateur radio rules apply to everything #     you send: no commercial content, no profanity, nothing encoded to #     obscure meaning, no entertainment broadcast. If you do not know, say so."

# Number of extra SMS parts for longer responses (0 = single 64-char reply)
extra_sms = 0

# Enable callsign whitelist
whitelist_enabled = false

# Only respond to these callsigns (wildcards OK: TA3*).
# With whitelist_enabled = true an EMPTY list means NOBODY, not everybody.
whitelist = []

# Per-sender rate limit, token bucket. A sender may ask `rate_burst` questions
# back to back, then one more per `rate_refill_s` seconds, up to the burst
# again once idle. Deliberately not a flat cooldown: someone meeting the
# gateway for the first time asks several questions in a row, and freezing
# them out is the wrong lesson. Set either to 0 to switch the limiter off.
rate_burst = 4
rate_refill_s = 180

# What a rate-limited sender is told, once per episode ({m} = minutes to wait).
# A silent refusal is indistinguishable from a broken gateway, and the person
# on the other end cannot tell which they are looking at. Kept to one message
# per episode: answering every message would turn a hammering sender into a
# hammering transmitter, on a shared RF resource and at your expense.
rate_notice = "Too many questions - please wait {m} min, then ask again"

# Whole-instance ceiling on questions answered per UTC day. 0 = no ceiling.
# Per-sender limits do not protect you from a thousand strangers asking one
# question each, which is what happens the first time somebody posts about
# your gateway. Set this to whatever you are willing to pay for in a day.
daily_limit = 0
daily_notice = "Daily question limit reached on this gateway - try tomorrow"

# One API key per provider, so switching "provider" above recalls that
# provider's own key automatically instead of overwriting a single field.
# Only the key matching the active provider is used. Must come after every
# other [extensions.ai_gateway] key above — TOML cannot reopen a table once
# a subtable of it has been declared.
[extensions.ai_gateway.api_keys]
puter = ""
groq = ""
openrouter = ""
openai = ""
anthropic = ""
deepseek = ""
custom = ""

# --- IMAP Email Receiver ---
# Polls your email inbox and forwards new emails as APRS messages.
# Email subject format: CALLSIGN message text
# Example: "TA3HRJ-7 Hello from email!" → sends APRS message to TA3HRJ-7
# Requires IMAP access. Gmail: enable IMAP + use an App Password.

[extensions.imap]
enabled = false

# IMAP server address and port
imap_server = "imap.gmail.com:993"

# Email login credentials
imap_username = ""
imap_password = ""

# How often to check for new emails (minutes)
poll_interval_mins = 5

# APRS callsign used as sender for forwarded emails
from_callsign = "EMAIL-5"

# Only forward emails from these addresses (empty = allow all)
allowed_senders = []
